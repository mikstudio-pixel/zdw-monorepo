{
    "name": "zdw/release-manager",
    "description": "Versioned, auditable WordPress content migrations for Zlin Design Week.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "ZDW\\ReleaseManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ZDW\\ReleaseManager\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always"
    },
    "config": {
        "sort-packages": true
    }
}
