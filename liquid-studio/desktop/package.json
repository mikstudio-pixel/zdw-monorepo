{
  "name": "zdw-liquid-studio",
  "version": "1.6.0",
  "description": "Offline video studio with the ZDW liquid glass renderer",
  "author": "ZDW",
  "private": true,
  "type": "module",
  "main": "main/main.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "sync:shaders": "node scripts/sync-shaders.mjs",
    "prestart": "npm run sync:shaders",
    "start": "electron .",
    "check": "node scripts/check.mjs",
    "test": "npm run sync:shaders && node --test tests/*.test.mjs",
    "test:e2e": "npm run sync:shaders && node tests/e2e.mjs",
    "predist": "npm run sync:shaders && npm run check",
    "dist": "electron-builder",
    "pack": "npm run sync:shaders && electron-builder --dir"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "@ffprobe-installer/ffprobe": "2.1.2"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0"
  },
  "build": {
    "appId": "cz.zdw.liquidstudio",
    "productName": "Liquid Studio",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "main/**",
      "renderer/**",
      "shared/**",
      "vendor/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/@ffprobe-installer/**"
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo"
    }
  }
}
