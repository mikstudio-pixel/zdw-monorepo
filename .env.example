WP_PORT=8080
ZDW_LOCAL_URL=http://localhost:8080
ZDW_SQL_DUMP=./zlindesignweek-migrate-20260728110645.sql.gz

DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress-local
DB_ROOT_PASSWORD=root-local

ZDW_LOCAL_ADMIN_USER=localadmin
ZDW_LOCAL_ADMIN_PASSWORD=zdw-local-change-me
ZDW_LOCAL_ADMIN_EMAIL=localadmin@localhost.invalid

# Nastavte na 1 jen pokud experiment opravdu potřebuje volat externí API.
ZDW_ALLOW_EXTERNAL_HTTP=0

# Oficiální udržovaná WordPress image pro PHP 8.3.
WORDPRESS_IMAGE=wordpress:php8.3-apache
WPCLI_IMAGE=wordpress:cli-php8.3
